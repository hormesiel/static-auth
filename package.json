{
  "name": "static-auth",
  "version": "2.1.2",
  "author": "Mickaël Allonneau <mickael.allonneau.pro@gmail.com>",
  "description": "The most simple way to add Basic Authentication to a static website hosted on Vercel.",
  "keywords": [
    "authentication",
    "basic",
    "now",
    "serverless",
    "static",
    "ssg",
    "vercel"
  ],
  "license": "MIT",
  "repository": "github:flawyte/static-auth",
  "homepage": "https://github.com/flawyte/static-auth",
  "source": "index.ts",
  "type": "module",
  "main": "dist/static-auth.cjs",
  "module": "dist/static-auth.module.mjs",
  "exports": {
    "require": "./dist/static-auth.cjs",
    "default": "./dist/static-auth.modern.mjs"
  },
  "scripts": {
    "build": "microbundle",
    "publish": "yarn build && npm publish"
  },
  "dependencies": {
    "basic-auth": "^3.0.0",
    "serve-static": "^2.2.1"
  },
  "devDependencies": {
    "@types/serve-static": "^2.2.0",
    "microbundle": "^0.15.1",
    "typescript": "^7.0.2"
  }
}
